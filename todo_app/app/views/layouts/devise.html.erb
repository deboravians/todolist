<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Todo App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "base/reset", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "base/tokens", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "base/utilities", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/buttons", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/cards", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "features/auth", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="auth-body">
    <main class="auth-page">
      <% if notice.present? %>
        <div class="auth-flash auth-flash--notice"><%= notice %></div>
      <% end %>

      <% if alert.present? %>
        <div class="auth-flash auth-flash--alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
