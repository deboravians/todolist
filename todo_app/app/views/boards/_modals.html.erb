<%# Modal de Criar Quadro %>
<dialog id="modal-create-board" class="modal">
  <div class="modal-card">
    <h2 class="modal-title">Criar novo Quadro</h2>
    <p class="modal-subtitle">
      Crie um quadro para organizar suas listas e tarefas (ex: Faculdade, Trabalho, Pessoal)
    </p>

    <%= form_with model: Board.new, url: boards_path, method: :post, class: "modal-form" do |f| %>
      <div>
        <label class="modal-label">Nome do Quadro</label>
        <%= f.text_field :title, class: "modal-input", placeholder: "Ex: Trabalho, Faculdade, Pessoal...", required: true %>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-outline btn-lg" data-close-modal>Cancelar</button>
        <%= f.submit "Criar Quadro", class: "btn btn-orange btn-lg" %>
      </div>
    <% end %>
  </div>
</dialog>

<%# Modal de Editar Quadro %>
<dialog id="modal-edit-board" class="modal">
  <div class="modal-card">
    <h2 class="modal-title">Editar Quadro</h2>
    <p class="modal-subtitle">Altere o nome do quadro</p>

    <form id="form-edit-board" class="modal-form" method="post" data-turbo="true">
      <input type="hidden" name="_method" value="patch">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <div>
        <label class="modal-label">Nome do Quadro</label>
        <input type="text"
               id="edit-board-title"
               name="board[title]"
               class="modal-input"
               required
               />
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-outline btn-lg" data-close-modal>Cancelar</button>
        <button type="submit" class="btn btn-orange btn-lg">Salvar</button>
      </div>
    </form>
  </div>
</dialog>

<%# Modal de Excluir Quadro %>
<dialog id="modal-delete-board" class="modal">
  <div class="modal-card">
    <h2 class="modal-title">Confirmar exclusão</h2>

    <p class="modal-danger">
      Tem certeza que deseja excluir o quadro "<span id="delete-board-title"></span>"?
      Todas as listas e tarefas deste quadro também serão removidas.
      Esta ação não pode ser desfeita.
    </p>

    <form id="form-delete-board" class="modal-actions" method="post" data-turbo="true">
      <input type="hidden" name="_method" value="delete">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <button type="button" class="btn btn-outline btn-lg" data-close-modal>Cancelar</button>
      <button type="submit" class="btn btn-red btn-lg">Excluir</button>
    </form>
  </div>
</dialog>
