<h1>Quadros</h1>

<p><%= link_to "Novo quadro", new_board_path %></p>

<ul>
  <% @boards.each do |board| %>
    <li>
      <%= link_to board.title, board_path(board) %>
      | <%= link_to "Editar", edit_board_path(board) %>
      | <%= button_to "Excluir", board_path(board), method: :delete, data: { confirm: "Tem certeza?" } %>
    </li>
  <% end %>
</ul>
