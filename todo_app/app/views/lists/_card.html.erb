<div class="list-card">
  <div class="list-card-header">
    <h3 class="list-title"><%= list.title %></h3>

    <div class="list-actions">
      <button type="button"
              class="icon-btn"
              title="Editar"
              data-open-edit-list
              data-board-id="<%= board.id %>"
              data-list-id="<%= list.id %>"
              data-list-title="<%= list.title %>">
        <%= image_tag "icons/edit.svg", class: "icon", alt: "" %>
      </button>

      <button type="button"
              class="icon-btn icon-btn-danger"
              title="Excluir"
              data-open-delete-list
              data-board-id="<%= board.id %>"
              data-list-id="<%= list.id %>"
              data-list-title="<%= list.title %>">
        <%= image_tag "icons/trash.svg", class: "icon", alt: "" %>
      </button>
    </div>
  </div>

  <button type="button"
          class="btn btn-purple btn-wide"
          data-open-create-task
          data-board-id="<%= board.id %>"
          data-list-id="<%= list.id %>">
    + Nova tarefa
  </button>

  <%= render "tasks/list", board: board, list: list %>
</div>
