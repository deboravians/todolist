<dialog id="modal-create-list" class="modal">
  <div class="modal-card">
    <h2 class="modal-title">Criar nova Lista</h2>
    <p class="modal-subtitle">
      Crie uma lista para organizar suas tarefas dentro do quadro
    </p>

    <%= form_with model: [@board, List.new], url: board_lists_path(@board), method: :post, class: "modal-form" do |f| %>
      <div>
        <label class="modal-label">Nome da Lista</label>
        <%= f.text_field :title, class: "modal-input", placeholder: "Ex: Matemática, Programação, Minha Empresa...", required: true %>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-outline btn-lg" data-close-modal>Cancelar</button>
        <%= f.submit "Criar Lista", class: "btn btn-orange btn-lg" %>
      </div>
    <% end %>
  </div>
</dialog>

<dialog id="modal-edit-list" class="modal">
  <div class="modal-card">
    <h2 class="modal-title">Editar Lista</h2>
    <p class="modal-subtitle">Altere o nome da lista</p>

    <form id="form-edit-list" class="modal-form" method="post" data-turbo="true">
      <input type="hidden" name="_method" value="patch">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <div>
        <label class="modal-label">Nome da Lista</label>
        <input id="edit-list-title"
               name="list[title]"
               class="modal-input"
               required
               />
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-outline btn-lg" data-close-modal>Cancelar</button>
        <button type="submit" class="btn btn-orange btn-lg">Salvar</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="modal-delete-list" class="modal">
  <div class="modal-card">
    <h2 class="modal-title">Confirmar exclusão</h2>

    <p class="modal-danger">
      Tem certeza que deseja excluir a lista "<span id="delete-list-title"></span>"?
      Todas as tarefas desta lista também serão removidas.
      Esta ação não pode ser desfeita.
    </p>

    <form id="form-delete-list" class="modal-actions" method="post" data-turbo="true">
      <input type="hidden" name="_method" value="delete">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <button type="button" class="btn btn-outline btn-lg" data-close-modal>Cancelar</button>
      <button type="submit" class="btn btn-red btn-lg">Excluir</button>
    </form>
  </div>
</dialog>
