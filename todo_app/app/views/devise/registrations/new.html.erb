<div class="auth-card">
  <h1 class="auth-title">Criar conta</h1>
  <p class="auth-subtitle">Preencha os dados para começar</p>

  <% if resource.errors.any? %>
    <div class="auth-errors">
      <strong>Corrija os campos abaixo:</strong>
      <ul>
        <% resource.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <div>
      <%= f.label :name, "Nome", class: "auth-label" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "auth-input" %>
    </div>

    <div>
      <%= f.label :email, "Email", class: "auth-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "auth-input" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "auth-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "auth-input" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar senha", class: "auth-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
    </div>

    <%= f.submit "Cadastrar", class: "auth-button" %>
  <% end %>

  <div class="auth-footer">
    Já tem conta?
    <%= link_to "Entrar", new_session_path(resource_name), class: "auth-link" %>
  </div>
</div>
